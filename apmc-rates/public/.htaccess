Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Clean URLs are deliberately not required. The application works using index.php?view=... / ?api=...

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(latest|health|query|summary|market|markets|discover)$ index.php?api=$1 [L,QSA]
  RewriteRule ^openapi\.json$ index.php?seo=openapi [L,QSA]
  RewriteRule ^sitemap\.xml$ index.php?seo=sitemap [L,QSA]
  RewriteRule ^robots\.txt$ index.php?seo=robots [L,QSA]
  RewriteRule ^llms\.txt$ index.php?seo=llms [L,QSA]
  RewriteRule ^\.well-known/apmc-data-agent\.json$ index.php?seo=agent-manifest [L,QSA]
</IfModule>
